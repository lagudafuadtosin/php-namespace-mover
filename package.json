{
    "name": "php-namespace-mover",
    "displayName": "PHP Namespace Mover",
    "description": "Move or rename a PHP file and its namespace, class and every use statement update. A maintained rebuild of PHP Namespace Resolver: import class, organize imports, remove unused, without freezing VS Code.",
    "version": "1.0.2",
    "publisher": "lagudafuadtosin",
    "author": "Fuad Laguda",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Linters",
        "Other"
    ],
    "keywords": [
        "php",
        "namespace",
        "namespace resolver",
        "php namespace resolver",
        "import",
        "import class",
        "auto import",
        "use",
        "use statement",
        "organize imports",
        "remove unused imports",
        "move",
        "move file",
        "rename",
        "rename class",
        "refactor",
        "psr-4",
        "psr-0",
        "composer",
        "laravel",
        "symfony"
    ],
    "galleryBanner": {
        "color": "#282c34",
        "theme": "dark"
    },
    "activationEvents": [
        "onLanguage:php",
        "workspaceContains:**/composer.json"
    ],
    "main": "./out/extension.js",
    "icon": "images/icon.png",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src/",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "npx mocha out/test/*.test.js",
        "test:integration": "node ./out/test/runTests.js"
    },
    "contributes": {
        "menus": {
            "editor/context": [
                {
                    "when": "resourceLangId == php",
                    "command": "phpNamespaceMover.import",
                    "group": "0_namespace_resolver@1"
                },
                {
                    "when": "resourceLangId == php",
                    "command": "phpNamespaceMover.importAll",
                    "group": "0_namespace_resolver@2"
                },
                {
                    "when": "resourceLangId == php",
                    "command": "phpNamespaceMover.expand",
                    "group": "0_namespace_resolver@3"
                },
                {
                    "when": "resourceLangId == php",
                    "command": "phpNamespaceMover.sort",
                    "group": "0_namespace_resolver@4"
                },
                {
                    "when": "resourceLangId == php",
                    "command": "phpNamespaceMover.removeUnused",
                    "group": "0_namespace_resolver@5"
                },
                {
                    "when": "resourceLangId == php",
                    "command": "phpNamespaceMover.generateNamespace",
                    "group": "0_namespace_resolver@6"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "PHP Namespace Mover",
            "properties": {
                "phpNamespaceMover.exclude": {
                    "type": "string",
                    "default": "**/node_modules/**",
                    "description": "Exclude glob pattern while finding files"
                },
                "phpNamespaceMover.autoSort": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically sort imports after adding a new one"
                },
                "phpNamespaceMover.sortOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically sort imports when a file is saved"
                },
                "phpNamespaceMover.sortMode": {
                    "type": "string",
                    "enum": [
                        "natural",
                        "length",
                        "alphabetical"
                    ],
                    "default": "natural",
                    "description": "How to sort imports: natural order, line length, or alphabetically"
                },
                "phpNamespaceMover.leadingSeparator": {
                    "type": "boolean",
                    "default": true,
                    "description": "Prepend a leading backslash when expanding class names"
                },
                "phpNamespaceMover.removeOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically remove unused imports when a file is saved"
                },
                "phpNamespaceMover.autoImportOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "On save, import the classes the file uses that have exactly one match"
                },
                "phpNamespaceMover.ignoreList": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Class names to exclude from all diagnostics (e.g. [\"Yii\"])"
                },
                "phpNamespaceMover.highlightNotImported": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable 'Class X is not imported' warnings"
                },
                "phpNamespaceMover.highlightNotUsed": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable 'Imported class X is not used' warnings"
                },
                "phpNamespaceMover.updateReferencesOnMove": {
                    "type": "string",
                    "enum": [
                        "ask",
                        "always",
                        "never"
                    ],
                    "default": "ask",
                    "enumDescriptions": [
                        "Ask before updating, with a preview option",
                        "Update without asking",
                        "Never update"
                    ],
                    "description": "When a PHP file or folder is moved or renamed, update its namespace and class name (from composer.json PSR-4) and every import and reference to it."
                }
            }
        },
        "commands": [
            {
                "title": "Import Class",
                "command": "phpNamespaceMover.import",
                "category": "PHP Namespace Mover"
            },
            {
                "title": "Import All Classes",
                "command": "phpNamespaceMover.importAll",
                "category": "PHP Namespace Mover"
            },
            {
                "title": "Expand Class",
                "command": "phpNamespaceMover.expand",
                "category": "PHP Namespace Mover"
            },
            {
                "title": "Sort Imports",
                "command": "phpNamespaceMover.sort",
                "category": "PHP Namespace Mover"
            },
            {
                "title": "Generate Namespace",
                "command": "phpNamespaceMover.generateNamespace",
                "category": "PHP Namespace Mover"
            },
            {
                "title": "Remove Unused Imports",
                "command": "phpNamespaceMover.removeUnused",
                "category": "PHP Namespace Mover"
            },
            {
                "title": "Rebuild Namespace Index",
                "command": "phpNamespaceMover.rebuildIndex",
                "category": "PHP Namespace Mover"
            },
            {
                "command": "phpNamespaceMover.organizeImports",
                "title": "Organize Imports",
                "category": "PHP Namespace Mover"
            }
        ],
        "keybindings": [
            {
                "command": "phpNamespaceMover.import",
                "key": "ctrl+alt+i",
                "when": "editorTextFocus"
            },
            {
                "command": "phpNamespaceMover.importAll",
                "key": "ctrl+alt+a",
                "when": "editorTextFocus"
            },
            {
                "command": "phpNamespaceMover.expand",
                "key": "ctrl+alt+e",
                "when": "editorTextFocus"
            },
            {
                "command": "phpNamespaceMover.sort",
                "key": "ctrl+alt+s",
                "when": "editorTextFocus"
            },
            {
                "command": "phpNamespaceMover.generateNamespace",
                "key": "ctrl+alt+g",
                "when": "editorTextFocus"
            },
            {
                "command": "phpNamespaceMover.removeUnused",
                "key": "ctrl+alt+r",
                "when": "editorTextFocus"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lagudafuadtosin/php-namespace-mover"
    },
    "bugs": {
        "url": "https://github.com/lagudafuadtosin/php-namespace-mover/issues"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.0",
        "@types/node": "18.x",
        "@types/vscode": "^1.75.0",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.55.0",
        "@vscode/test-electron": "^2.3.0",
        "eslint": "^9.39.2",
        "mocha": "^10.2.0",
        "typescript": "^5.3.0"
    },
    "homepage": "https://github.com/lagudafuadtosin/php-namespace-mover#readme"
}
